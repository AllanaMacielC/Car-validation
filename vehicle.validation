class Carro:
    def __init__(self, modelo, dono, valor):
        self.modelo = modelo
        self.dono = dono
        self.valor = valor

  # Regra: só vende se for o dono E tiver autenticidade confirmada (autenticidade/assinatura válida)
    def vender(self, quem_vende, autenticidade_confirmada, novo_dono, novo_valor):
        if quem_vende == self.dono and autenticidade_confirmada == True:
            self.dono = novo_dono
            self.valor = novo_valor
            print("Venda aprovada! Novo dono:", self.dono)
        else:
            print("Venda bloqueada! Falha na autenticidade ou vendedor não é o dono.")

# ==========================================
# TESTE: IMPOSTOR TENTANDO SE PASSAR PELA PROPRIETÁRIA
# ==========================================

# 1. O carro pertence à Maria
carro1 = Carro("Onix", "Maria", 50000)

# 2. Um golpista usa o nome "Maria", mas a autenticidade é Falsa
carro1.vender("Maria", False, "Carlos", 45000)
